<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Slide 12 - Incidentes vs Requerimientos</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; }
    body { background: #eef4fb; }

    .slide {
      width: 1600px;
      height: 900px;
      background: linear-gradient(180deg, #ffffff 0%, #f4f8ff 100%);
      color: #08245c;
      overflow: hidden;
      position: relative;
      padding: 22px 26px 0 26px;
    }

    .bottom-band {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 25px;
      background: linear-gradient(90deg, #082d91 0%, #0d65df 55%, #13b7ba 100%);
      z-index: 1;
    }

    .header {
      position: relative;
      z-index: 3;
      height: 86px;
      display: flex;
      align-items: flex-start;
      margin-bottom: 8px;
      padding-right: 390px;
    }

    .title-wrap { display: flex; align-items: flex-start; gap: 18px; min-width: 0; }

    .title-bar {
      width: 13px;
      height: 58px;
      border-radius: 7px;
      background: linear-gradient(180deg, #0d65df, #13b7ba);
      margin-top: 4px;
      flex: 0 0 13px;
    }

    .title {
      font-size: 39px;
      line-height: 1.04;
      font-weight: 900;
      color: #071f5c;
      letter-spacing: -0.8px;
      text-transform: uppercase;
      max-width: 1080px;
      white-space: normal;
    }

    .top-curve {
      position: absolute;
      top: 0;
      right: 0;
      width: 360px;
      height: 86px;
      background: linear-gradient(135deg, #0d65df 0%, #082d91 100%);
      border-bottom-left-radius: 105px;
      z-index: 1;
    }

    .logo {
      position: fixed;
      top: 27px;
      right: 40px;
      z-index: 5;
      display: flex;
      align-items: center;
      gap: 12px;
      color: #ffffff;
      font-size: 39px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: 0.6px;
      text-transform: uppercase;
    }

    .logo-symbol {
      width: 50px;
      height: 30px;
      border-radius: 50%;
      border: 5px dashed rgba(255,255,255,0.88);
      transform: rotate(-18deg);
      flex: 0 0 auto;
    }

    .kpi-row {
      position: relative;
      z-index: 3;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 14px;
      margin-bottom: 16px;
    }

    .kpi-card {
      height: 124px;
      background: #ffffff;
      border: 1px solid #d2dceb;
      border-radius: 18px;
      box-shadow: 0 8px 18px rgba(11,45,92,0.16);
      display: grid;
      grid-template-columns: 82px 1fr;
      align-items: center;
      gap: 13px;
      padding: 14px;
      overflow: hidden;
    }

    .kpi-icon {
      width: 72px;
      height: 72px;
      border-radius: 18px;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 35px;
      line-height: 1;
      font-weight: 900;
      box-shadow: 0 9px 16px rgba(0,0,0,0.16);
    }

    .bg-blue { background: linear-gradient(135deg, #1264df, #06339b); }
    .bg-teal { background: linear-gradient(135deg, #1ac4c6, #087a87); }
    .bg-orange { background: linear-gradient(135deg, #ffb51d, #ff5f00); }
    .bg-purple { background: linear-gradient(135deg, #9542e8, #5520aa); }

    .kpi-label {
      font-size: 13px;
      font-weight: 900;
      color: #092869;
      line-height: 1.12;
      text-transform: uppercase;
      margin-bottom: 7px;
    }

    .kpi-value { font-size: 35px; font-weight: 900; line-height: 1; color: #0d55d8; }
    .teal { color: #0a8a96; }
    .orange { color: #ff6200; }
    .purple { color: #7a35d7; }

    .kpi-sub {
      font-size: 11px;
      font-weight: 700;
      color: #243756;
      line-height: 1.15;
      margin-top: 5px;
    }

    .main-grid {
      position: relative;
      z-index: 3;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 18px;
      height: 455px;
      margin-bottom: 16px;
    }

    .panel {
      background: #ffffff;
      border: 1px solid #cddbef;
      border-radius: 18px;
      box-shadow: 0 8px 18px rgba(11,45,92,0.14);
      overflow: hidden;
    }

    .panel-title {
      height: 42px;
      background: linear-gradient(90deg, #0b3298 0%, #0d5dd4 50%, #11b7bb 100%);
      color: white;
      display: flex;
      align-items: center;
      padding-left: 22px;
      font-size: 21px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.2px;
    }

    .panel-body { height: 413px; padding: 24px 30px; }
    .donut-layout { display: grid; grid-template-columns: 0.58fr 0.42fr; align-items: center; gap: 24px; }
    .donut-wrap { display: flex; justify-content: center; align-items: center; height: 100%; }

    .donut-center-label {
      font-size: 28px;
      font-weight: 900;
      fill: #092869;
      text-anchor: middle;
    }

    .donut-center-sub {
      font-size: 14px;
      font-weight: 900;
      fill: #092869;
      text-anchor: middle;
      text-transform: uppercase;
    }

    .legend { display: flex; flex-direction: column; gap: 28px; }
    .legend-item { display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: start; }
    .dot { width: 18px; height: 18px; border-radius: 50%; margin-top: 5px; }
    .dot-blue { background: #1250c7; }
    .dot-orange { background: #ff6200; }
    .legend-title { font-size: 20px; font-weight: 900; color: #092869; }
    .legend-sub { font-size: 16px; color: #263a58; margin-top: 5px; }

    table { width: 100%; border-collapse: collapse; table-layout: fixed; margin-top: 35px; }
    th {
      background: #0d3298;
      color: white;
      padding: 18px 8px;
      text-transform: uppercase;
      font-size: 16px;
      font-weight: 900;
      border: 1px solid #c7d4e8;
    }
    td {
      padding: 22px 10px;
      border: 1px solid #c7d4e8;
      color: #0b2148;
      text-align: center;
      font-size: 19px;
      font-weight: 900;
    }
    tbody tr:nth-child(even) td { background: #eaf3ff; }

    .bottom-insight {
      position: relative;
      z-index: 3;
      height: 112px;
      background: #ffffff;
      border: 2px solid #1b65e3;
      border-radius: 18px;
      box-shadow: 0 8px 18px rgba(11,45,92,0.10);
      display: grid;
      grid-template-columns: 98px 315px 2px 1fr;
      gap: 18px;
      align-items: center;
      padding: 18px 22px;
    }

    .bottom-icon {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: linear-gradient(135deg, #1264df, #06339b);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      font-weight: 900;
      box-shadow: 0 8px 16px rgba(11,45,92,0.18);
    }
    .bottom-title { font-size: 26px; font-weight: 900; color: #092d91; line-height: 1.1; text-transform: uppercase; }
    .bottom-divider { width: 2px; height: 62px; background: #b6c7e3; }
    .bottom-text { font-size: 18px; color: #1d2f4f; line-height: 1.35; }
  </style>
  <link rel="stylesheet" href="/public/comm-standard.css" />
</head>
<body>
<%
  const total = Number(totalAtenciones || 0);
  const inc = Number(incidentes || 0);
  const req = Number(requerimientos || 0);
  const incPct = total ? inc / total : 0;
  const reqPct = total ? req / total : 0;
  const r = 96;
  const c = 2 * Math.PI * r;
  const incLen = c * incPct;
  const reqLen = c * reqPct;
  const tituloFinal = String(titulo || '').toUpperCase();
  const logoFinal = typeof logoText !== 'undefined' ? logoText : 'COMM';
%>
<div class="slide">
  <div class="bottom-band"></div>
  <div class="top-curve"></div>
  <div class="logo"><div class="logo-symbol"></div><div><%= logoFinal %></div></div>

  <div class="header">
    <div class="title-wrap">
      <div class="title-bar"></div>
      <div class="title"><%= tituloFinal %></div>
    </div>
  </div>

  <div class="kpi-row">
    <div class="kpi-card"><div class="kpi-icon bg-blue">▣</div><div><div class="kpi-label">Total<br>Atenciones</div><div class="kpi-value"><%= totalAtenciones %></div><div class="kpi-sub">100% del total</div></div></div>
    <div class="kpi-card"><div class="kpi-icon bg-teal">◇</div><div><div class="kpi-label">Incidentes</div><div class="kpi-value teal"><%= incidentes %></div><div class="kpi-sub"><%= pctIncidentes %> del total</div></div></div>
    <div class="kpi-card"><div class="kpi-icon bg-orange">▤</div><div><div class="kpi-label">Requerimientos</div><div class="kpi-value orange"><%= requerimientos %></div><div class="kpi-sub"><%= pctRequerimientos %> del total</div></div></div>
    <div class="kpi-card"><div class="kpi-icon bg-purple">◔</div><div><div class="kpi-label">% Participación de<br>Incidentes</div><div class="kpi-value purple"><%= pctIncidentes %></div><div class="kpi-sub">del total</div></div></div>
    <div class="kpi-card"><div class="kpi-icon bg-teal">◕</div><div><div class="kpi-label">% Participación de<br>Requerimientos</div><div class="kpi-value teal"><%= pctRequerimientos %></div><div class="kpi-sub">del total</div></div></div>
    <div class="kpi-card"><div class="kpi-icon bg-blue">⚖</div><div><div class="kpi-label">Brecha</div><div class="kpi-value"><%= brecha %></div><div class="kpi-sub">Req. - Inc.</div></div></div>
  </div>

  <div class="main-grid">
    <div class="panel">
      <div class="panel-title">Incidente vs Requerimiento Mensual</div>
      <div class="panel-body donut-layout">
        <div class="donut-wrap">
          <svg width="355" height="330" viewBox="0 0 355 330" aria-label="Donut incidentes vs requerimientos">
            <circle cx="170" cy="164" r="96" fill="none" stroke="#e7eef8" stroke-width="58" />
            <circle cx="170" cy="164" r="96" fill="none" stroke="#1250c7" stroke-width="58" stroke-dasharray="<%= incLen %> <%= c - incLen %>" stroke-dashoffset="0" transform="rotate(-90 170 164)" />
            <circle cx="170" cy="164" r="96" fill="none" stroke="#ff6200" stroke-width="58" stroke-dasharray="<%= reqLen %> <%= c - reqLen %>" stroke-dashoffset="<%= -incLen %>" transform="rotate(-90 170 164)" />
            <circle cx="170" cy="164" r="64" fill="#ffffff" />
            <text x="170" y="156" class="donut-center-label"><%= totalAtenciones %></text>
            <text x="170" y="178" class="donut-center-sub">Atenciones</text>
            <text x="170" y="195" class="donut-center-sub">Totales</text>
          </svg>
        </div>
        <div class="legend">
          <div class="legend-item"><span class="dot dot-blue"></span><div><div class="legend-title">Incidentes</div><div class="legend-sub"><%= incidentes %> (<%= pctIncidentes %>)</div></div></div>
          <div class="legend-item"><span class="dot dot-orange"></span><div><div class="legend-title">Requerimientos</div><div class="legend-sub"><%= requerimientos %> (<%= pctRequerimientos %>)</div></div></div>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-title">Resumen de Atenciones por Tipo</div>
      <div class="panel-body">
        <table>
          <thead><tr><th>UP</th><th>Incidentes</th><th>Requerimientos</th><th>Total</th></tr></thead>
          <tbody>
            <tr><td><%= tabla.up %></td><td><%= tabla.incidentes %></td><td><%= tabla.requerimientos %></td><td><%= tabla.total %></td></tr>
            <tr><td>%</td><td><%= tabla.pctIncidentes %></td><td><%= tabla.pctRequerimientos %></td><td><%= tabla.pctTotal %></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="bottom-insight">
    <div class="bottom-icon">↗</div>
    <div class="bottom-title">Distribución de Atenciones por Tipo</div>
    <div class="bottom-divider"></div>
    <div class="bottom-text"><%= insight %></div>
  </div>
</div>
</body>
</html>
